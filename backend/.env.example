JWT_SECRET=your-super-secret-key-change-this
PORT=4000
DATABASE_URL=./helpdesk.db
CORS_ORIGIN=http://localhost:3000,https://frontend-ecru-three-34.vercel.app
APP_URL=http://localhost:3000

# AWS RDS (MySQL). When DB_HOST is set the app uses MySQL instead of the
# local SQLite file above. Leave DB_HOST unset for local development.
# DB_HOST=your-rds-endpoint.rds.amazonaws.com
# DB_PORT=3306
# DB_USER=admin
# DB_PASSWORD=change-me
# DB_NAME=helpdesk

# SMTP is optional. When present, ticket confirmations and replies send email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=HelpDesk Lite <support@example.com>
